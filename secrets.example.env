# Copy the lines below into .psycheros/plugin-secrets/icloud.env
# (outside this plugin directory) and fill in real values.
# Generate the app-specific password at account.apple.com
# (Sign-In and Security → App-Specific Passwords; 2FA required on the account).
PSYCHEROS_PLUGIN_ICLOUD_APPLE_ID=your.entity@icloud.com
PSYCHEROS_PLUGIN_ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
# Operator's explicit yes to outgoing mail (icloud_mail action="send").
PSYCHEROS_PLUGIN_ICLOUD_ALLOW_SEND=1
# Optional display name on outgoing mail.
# PSYCHEROS_PLUGIN_ICLOUD_SENDER_NAME=
